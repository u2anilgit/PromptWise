!.claude/settings.json
!.claude/CLAUDE.md
.cursor/
.gemini/
.idea/
.vscode/
*.swp
*.swo

# ── Planning / spec artifacts (kept local, out of the repo) ─────────────
docs/superpowers/
specs/
plans/
*.original.md
memory/
MEMORY.md
# implementation plans / roadmaps / gap analyses — internal, local only
docs/ROADMAP.md
docs/GAP_ANALYSIS_*.md
docs/PHASE*_ROADMAP.md
docs/*_PLAN_*.md
docs/*-plan.html
docs/AGILE_PLAN_*.md
docs/IMPLEMENTATION_PLAN_*.md

# ── Local dev worktrees (subagent-driven-development isolation) ─────────
.worktrees/

# ── OS / cloud temp ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.tmp.driveupload/
.tmp.drivedownload/

# Marketing / drafts — keep local, not part of the shipped plugin
*.docx

