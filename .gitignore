# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Runtime / local governance artifacts ────────────────────────────────
# hash-chained audit trail (runtime, per-machine)
promptwise_audit.jsonl
# project-local runtime state (audit, denials, counters, model overlay,
# governor budget overlay + undo ledger + proposals — Phase 9)
.promptwise/
# local governance policy (copy from policy.example.yaml)
config/policy.yaml
# local admin config (feature flags/budget/KB settings, copy from
# admin.example.yaml) -- runtime-written by set_feature_flag, same
# tracked-example/gitignored-real convention as policy.yaml above
config/admin.yaml
# local dashboard credentials (copy from dashboard_auth.yaml.example),
# same tracked-example/gitignored-real convention as policy.yaml above
config/dashboard_auth.yaml
# local remote MCP transport credentials (copy from mcp_auth.yaml.example),
# same tracked-example/gitignored-real convention as policy.yaml above
config/mcp_auth.yaml

# ── Source bundle drop (not part of the package) ─────────────────────────
files/
files.zip

# ── Virtual environments / secrets ──────────────────────────────────────
venv/
.venv/
env/
.env
*.env

# ── Testing ─────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Runtime data / db / logs ────────────────────────────────────────────
*.log
logs/
*.sqlite
*.db

